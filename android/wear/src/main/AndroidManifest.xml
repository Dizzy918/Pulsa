<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-feature android:name="android.hardware.type.watch"/>

  <uses-permission android:name="android.permission.RECORD_AUDIO"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
  <uses-permission android:name="android.permission.WAKE_LOCK"/>

  <application
      android:name=".WearApp"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:theme="@android:style/Theme.DeviceDefault">

    <!-- Runs with or without the phone nearby. -->
    <meta-data android:name="com.google.android.wearable.standalone" android:value="true"/>
    <!-- The watch app handles alerts itself; stop the phone's notifications
         from also being bridged over (prevents double vibrations). -->
    <meta-data android:name="com.google.android.wearable.notificationBridgeMode" android:value="NO_BRIDGING"/>
    <uses-library android:name="com.google.android.wearable" android:required="false"/>

    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>

    <!-- Standalone mode: watch mic + on-watch YAMNet inference. -->
    <service
        android:name=".ListenService"
        android:exported="false"
        android:foregroundServiceType="microphone"/>

    <!-- Companion mode: detections pushed from the phone over the Data Layer. -->
    <service android:name=".DataListenerService" android:exported="true">
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED"/>
        <data android:scheme="wear" android:host="*" android:pathPrefix="/tactiq"/>
      </intent-filter>
    </service>
  </application>
</manifest>
